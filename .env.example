# -----------------------------------------------------------------------------
# flexIA backend configuration
#
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
#
# Used by both the native runner (scripts/run.sh) and Docker Compose.
# -----------------------------------------------------------------------------

# --- General -----------------------------------------------------------------
# Enable the optional MQTT broker (true/false)
ENABLE_MQTT=true

# --- Redis ---------------------------------------------------------------
REDIS_PORT=6379
# Leave empty to disable authentication (fine for local/dev use only)
REDIS_PASSWORD=
# Max memory Redis is allowed to use, e.g. 256mb, 1gb, 0 = unlimited
REDIS_MAXMEMORY=256mb
# Eviction policy applied once REDIS_MAXMEMORY is reached
REDIS_MAXMEMORY_POLICY=allkeys-lru
# Append-only file persistence (yes/no)
REDIS_APPENDONLY=yes
REDIS_APPENDFSYNC=everysec
# RDB snapshot retention rules: "<seconds> <changes>" pairs, space separated
# e.g. "3600 1 300 100 60 10000" saves a snapshot if >=1 key changed in the
# last hour, >=100 keys changed in the last 5 min, or >=10000 in the last min
REDIS_SAVE=3600 1 300 100 60 10000
# Where Redis data is persisted on the host
REDIS_DATA_DIR=./data/redis

# --- MQTT (Mosquitto) --------------------------------------------------------
MQTT_PORT=1883
MQTT_WEBSOCKETS_PORT=9001
# Allow clients to connect without credentials (true/false)
MQTT_ALLOW_ANONYMOUS=true
# Optional single set of credentials, used when MQTT_ALLOW_ANONYMOUS=false
# (or in addition to anonymous access)
MQTT_USERNAME=
MQTT_PASSWORD=
# Maximum accepted MQTT packet size in bytes (0 = broker default/unlimited)
MQTT_MAX_PACKET_SIZE=0
MQTT_MAX_QUEUED_MESSAGES=1000
MQTT_MAX_KEEPALIVE=65
# Persist retained messages / subscriptions to disk (true/false)
MQTT_PERSISTENCE=true
# Where MQTT data/logs are persisted on the host
MQTT_DATA_DIR=./data/mosquitto
MQTT_LOG_DIR=./logs/mosquitto
